#!/usr/bin/env bash
# Run the tests. Extra args go to swift test: `./scripts/test --filter name`.
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/swift-env

# A test that lets a stop of the main run loop reach the outermost loop ends the process with
# exit 0 and no summary, so the exit status alone reads as a pass. Only Swift Testing's closing
# "Test run with N tests ... after ..." line counts.
verify_run() {
  perl -CSD -Mutf8 -e '
    my ($summary, $last);
    while (<>) {
      $summary = 1 if /^\S Test run with \d+ tests?\b.* (?:passed|failed) after /;
      $last = $1 if /^◇ Test (?!run started|case )(.*) started\.$/;
    }
    exit 0 if $summary;
    print STDERR "tests: the run exited 0 without the \"Test run with N tests\" summary line.\n";
    print STDERR "  last test started: $last\n" if defined $last;
    exit 1;
  ' "$1"
}

log="$(mktemp)"
trap 'rm -f "$log"' EXIT
status=0
swift_cmd test "$@" | tee "$log" || status=$?
[ "$status" -ne 0 ] || verify_run "$log" || status=1
exit "$status"
