#!/usr/bin/env bash
# Tier rules the compiler can't see. Dependency direction is enforced by the build itself (see
# docs/map.md); this covers which system frameworks each tier may use.
#
# Each rule has a file in scripts/arch-fixtures/ that breaks it. The script first checks that
# every rule catches its fixture, so a pattern that stops matching fails here instead of passing
# silently, then checks Sources.
set -euo pipefail
cd "$(dirname "$0")/.."

# name|pattern, a Perl regex matched against each file whole. A fixture named <name>.swift
# breaks each rule.
ui_rules=(
  'ui-import|^[ \t]*(@[A-Za-z_]+\s+)*import\s+(AppKit|SwiftUI|Cocoa|Carbon)\b'
)

# hits <pattern> <path...>: each match in the Swift files at or under <path...>, comment lines
# left out, as file:line:text. A path that doesn't exist fails the script: a renamed folder
# would otherwise pass unchecked.
hits() {
  local pattern=$1 path; shift
  for path in "$@"; do
    if [ ! -e "$path" ]; then
      printf 'scripts/arch: %s does not exist\n' "$path" >&2
      exit 2
    fi
  done
  find "$@" -name '*.swift' -type f -print0 | xargs -0 -r env PATTERN="$pattern" perl -0777 -ne '
    my $source = $_;
    # Blank comment lines, keeping the line breaks, so lines still count.
    $source =~ s{^[ \t]*//[^\n]*}{}mg;
    while ($source =~ /$ENV{PATTERN}/mg) {
      my $start = $-[0];
      my $line = 1 + (substr($source, 0, $start) =~ tr/\n//);
      my $lineStart = rindex($source, "\n", $start) + 1;
      my $lineEnd = index($source, "\n", $start);
      $lineEnd = length($source) if $lineEnd < 0;
      print "$ARGV:$line:" . substr($source, $lineStart, $lineEnd - $lineStart) . "\n";
    }
  '
}

failed=0

for rule in "${ui_rules[@]}"; do
  name=${rule%%|*}
  fixture="scripts/arch-fixtures/$name.swift"
  if [ ! -f "$fixture" ]; then
    printf 'rule %s has no fixture at %s\n' "$name" "$fixture" >&2
    failed=1
  elif [ -z "$(hits "${rule#*|}" "$fixture")" ]; then
    printf 'rule %s no longer catches %s\n' "$name" "$fixture" >&2
    failed=1
  fi
done
for fixture in scripts/arch-fixtures/*.swift; do
  name=$(basename "$fixture" .swift)
  if ! printf '%s\n' "${ui_rules[@]}" | grep -q "^$name|"; then
    printf '%s breaks no rule of scripts/arch\n' "$fixture" >&2
    failed=1
  fi
done

# check <message> <paths, space-separated> <rule...>
check() {
  local message=$1 paths=$2 rule bad; shift 2
  for rule in "$@"; do
    # $paths splits on spaces on purpose: Sources paths have none.
    bad=$(hits "${rule#*|}" $paths)
    if [ -n "$bad" ]; then
      printf '%s (%s):\n%s\n' "$message" "${rule%%|*}" "$bad" >&2
      failed=1
    fi
  done
}

check 'UI framework imported below the interface tier' 'Sources/Base Sources/Search' \
  "${ui_rules[@]}"

[ "$failed" -eq 0 ] || exit 1
echo "every rule catches its fixture; no UI imports in Base or Search"
